<?xml version="1.0" encoding="utf-8"?>
<!--
  Значок для Android 8 и новее: сукно снизу, карты сверху, форма — как решит
  лаунчер. Третий слой (monochrome) — для «тематических значков» Android 13+:
  система берёт из него только очертания и красит своим цветом, поэтому здесь
  годится тот же рисунок без цвета.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
