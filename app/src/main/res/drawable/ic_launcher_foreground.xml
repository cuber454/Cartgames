<?xml version="1.0" encoding="utf-8"?>
<!--
  Значок приложения: две карты веером на сукне.

  Выбор мой, а не владелицы: картинку ей выбирать нечем — она незрячая, и
  спросить у неё «какой значок» значит переложить на неё работу зрячего (её
  слова, 20.09). Отсюда и вид: белые карты на тёмно-зелёном сукне читаются
  силуэтом, красная масть — единственное цветное пятно. Такой значок узнаётся
  и в мелком размере, и боковым зрением, и при дальтонизме: форму несёт сам
  рисунок карт, цвет только помогает.

  Между картами оставлена полоса сукна: без неё две белые карты сливаются в
  одно пятно с выемкой посередине — так значок и выглядел на первой пробе.
  Разведены они сильно, насколько позволяет круг в 66 dp, за который маска
  лаунчера не заходит ни на одной форме значка: карты поэтому неширокие и
  наклонены всего на десять градусов.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Левая карта — черви. -->
    <group
        android:pivotX="37.5"
        android:pivotY="55"
        android:rotation="-10">
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M28,37 L47,37 A3,3 0 0 1 50,40 L50,70 A3,3 0 0 1 47,73 L28,73 A3,3 0 0 1 25,70 L25,40 A3,3 0 0 1 28,37 Z" />
        <!-- Масть вписана в квадрат 15x15 посреди карты: фигура нарисована в
             квадрате 24x24, отсюда множитель 0.625. -->
        <group
            android:scaleX="0.625"
            android:scaleY="0.625"
            android:translateX="30"
            android:translateY="47.5">
            <path
                android:fillColor="#C62828"
                android:pathData="M12,21.35 L10.55,20.03 C5.4,15.36 2,12.28 2,8.5 C2,5.42 4.42,3 7.5,3 C9.24,3 10.91,3.81 12,5.09 C13.09,3.81 14.76,3 16.5,3 C19.58,3 22,5.42 22,8.5 C22,12.28 18.6,15.36 13.45,20.04 L12,21.35 Z" />
        </group>
    </group>

    <!-- Правая карта — бубна. -->
    <group
        android:pivotX="70.5"
        android:pivotY="55"
        android:rotation="10">
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M61,37 L80,37 A3,3 0 0 1 83,40 L83,70 A3,3 0 0 1 80,73 L61,73 A3,3 0 0 1 58,70 L58,40 A3,3 0 0 1 61,37 Z" />
        <group
            android:scaleX="0.625"
            android:scaleY="0.625"
            android:translateX="63"
            android:translateY="47.5">
            <path
                android:fillColor="#C62828"
                android:pathData="M12,2 L22,12 L12,22 L2,12 Z" />
        </group>
    </group>
</vector>
