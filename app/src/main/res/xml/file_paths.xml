<?xml version="1.0" encoding="utf-8"?>
<!--
  Что приложение отдаёт наружу. Дверь ровно одна и ведёт ровно к журналу:
  имя файла здесь совпадает с Journal.FILE_NAME, и если журнал когда-нибудь
  переименуют, строку надо поправить вместе с ним — иначе «Отправить»
  молча перестанет работать.
-->
<paths>
    <!--
      Корень двери — каталог, и только каталог. Провайдер ищет файл внутри
      корня, отрезая корень от пути; файл, равный корню, внутри себя не
      лежит, и попытка отрезать от него корень падает. Отсюда и бралось
      «журнал пуст» у журнала с сотней строк: исключение проглатывалось в
      необработанный null, а пустой журнал — самое правдоподобное, чем его
      можно объяснить.

      Имя каталога здесь совпадает с Journal.DIR_NAME, имя файла — с
      Journal.FILE_NAME: переименуют одно, поправить надо оба.
    -->
    <files-path
        name="journal"
        path="journal" />
</paths>
