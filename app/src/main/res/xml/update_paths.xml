<?xml version="1.0" encoding="utf-8"?>
<!--
  Что приложение отдаёт наружу для установки обновления. Дверь ведёт ровно к
  каталогу со скачанной сборкой: имя каталога здесь совпадает с Update.DIR_NAME,
  и если его переименуют, строку надо поправить вместе с ним — иначе кнопка
  «Установить» молча перестанет открывать установщик.

  Корень — каталог, и только каталог: провайдер ищет файл внутри корня, отрезая
  корень от пути. Файл, равный корню, внутри себя не лежит.
-->
<paths>
    <cache-path
        name="updates"
        path="updates" />
</paths>
