<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Короткая вибрация на ход соперника: в шумном месте это единственный
         способ понять, что бот сходил и ждёт тебя. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Список синтезаторов речи. С Android 11 приложение видит чужие
         пакеты, только если спросит о них заранее: без этого объявления
         в настройках остаётся один системный движок, и выбрать RHVoice
         или Samsung TTS невозможно. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.CardGames">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
