<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Короткая вибрация на ход соперника: в шумном месте это единственный
         способ понять, что бот сходил и ждёт тебя. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Обновление: приложение само спрашивает у GitHub, что вышло нового, и
         тянет сборку. Без сети обновлений не будет, но игра работает. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Установка скачанной сборки. Разрешение нужно на то, чтобы установка
         вообще была возможна: без него система не примет от приложения ни
         системного окна, ни сессии установки. Выдаётся оно переключателем
         «Установка неизвестных приложений» — приложение ведёт туда игрока
         само, когда приходит время ставить сборку. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Ставить обновление молча, без системного окна. С Android 12 система
         это разрешает, если приложение обновляет само себя и просит не
         спрашивать ([Update.install]); с этим разрешением установка идёт без
         единого нажатия. Разрешение обычное: телефон выдаёт его при установке
         и ни о чём не спрашивает. До Android 12 оно бесполезно — система
         такого не умеет и окно покажет всё равно, поэтому установка там идёт
         старой дорогой, через окно. -->
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />

    <!-- Список синтезаторов речи. С Android 11 приложение видит чужие
         пакеты, только если спросит о них заранее: без этого объявления
         в настройках остаётся один системный движок, и выбрать RHVoice
         или Samsung TTS невозможно. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>

        <!-- Кто в телефоне берётся показать системное окно установки. Заявка
             нужна не для того, чтобы окно открылось, а чтобы приложение могло
             узнать, кто его откроет: с Android 11 чужие пакеты ему не видны,
             и без этой строки resolveActivity отвечает «никто» даже там, где
             установщик на месте. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="application/vnd.android.package-archive" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.CardGames">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Итог установки. Тихая установка кончается не в приложении, а у
             системы: она и сообщает, чем дело кончилось. Приёмник ловит этот
             ответ и записывает его — сказать вслух в этот момент нечем,
             синтезатора у приёмника нет, поэтому слова прозвучат при
             следующем входе в игру. -->
        <receiver
            android:name=".update.InstallResultReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="games.cardgames.action.INSTALL_RESULT" />
            </intent-filter>
        </receiver>

        <!-- Журнал уезжает наружу кнопкой «Отправить»: во внутреннюю память
             приложения снаружи хода нет, и единственная дверь — этот
             провайдер. Отдаёт он ровно один файл (журнал) и только тому, кому
             игрок сам его отправил, — на время отправки и не дольше. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.journal"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Скачанная сборка уезжает системному установщику той же дверью, что
             и журнал, но из другого корня: журнал — в памяти приложения,
             сборка — в кэше. Отдаётся один файл и только на время установки. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/update_paths" />
        </provider>
    </application>

</manifest>
